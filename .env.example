# --- Setup-time credentials (used by `lazyanalytics setup`, `sites add/remove`, `usage`) ---
# Cloudflare API token. Create at: dash.cloudflare.com > Account API Tokens
# Least-privilege permissions: Account > Workers Scripts > Edit
#                              Account > Account Analytics > Read
CLOUDFLARE_API_TOKEN=

# Cloudflare account ID (32-char hex).
# Found at: dash.cloudflare.com > Workers & Pages > right sidebar
CF_ACCOUNT_ID=

# --- Query-time credentials (normally written to ~/.config/lazyanalytics/.env by setup) ---
# Your deployed worker URL, e.g. https://lazyanalytics.YOUR-SUBDOMAIN.workers.dev
ANALYTICS_API_URL=

# The API_SECRET generated during setup (bearer token for /api/* queries).
ANALYTICS_API_TOKEN=
