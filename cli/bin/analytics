#!/usr/bin/env bash
# Analytics CLI launcher with OneCLI proxy support
#
# The only thing an agent needs:
#   ONECLI_TOKEN=<aoc_token> analytics stats --site farei.me
#
# OneCLI handles all credentials (API tokens injected via proxy)
# and config (ANALYTICS_API_URL, CF_ACCOUNT_ID fetched from OneCLI).
#
# Direct mode (no OneCLI):
#   ANALYTICS_API_URL=... ANALYTICS_API_TOKEN=... analytics stats --site farei.me

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
ONECLI_API="${ONECLI_API:-http://localhost:10254}"

# If ONECLI_TOKEN is set, configure proxy mode and fetch config
if [ -n "$ONECLI_TOKEN" ]; then
  ONECLI_GW="${ONECLI_HOST:-localhost:10255}"
  export HTTPS_PROXY="http://x:${ONECLI_TOKEN}@${ONECLI_GW}"
  export NODE_USE_ENV_PROXY=1

  # Fetch service config from OneCLI vault
  # Agent authenticates with its own aoc_ token. OneCLI returns decrypted
  # config values (secrets with "config:" prefix) as key-value pairs.
  # One call, no admin key needed, everything co-located in the vault.
  if [ -z "$ANALYTICS_API_URL" ] || [ -z "$CF_ACCOUNT_ID" ]; then
    _CFG=$(curl -sf "${ONECLI_API}/api/agent-config" \
      -H "Authorization: Bearer ${ONECLI_TOKEN}" 2>/dev/null)
    if [ -n "$_CFG" ]; then
      # Safe JSON extraction without eval — only allow known keys with alphanumeric values
      _URL=$(echo "$_CFG" | python3 -c "import sys,json; print(json.load(sys.stdin).get('ANALYTICS_API_URL',''))" 2>/dev/null)
      _AID=$(echo "$_CFG" | python3 -c "import sys,json; print(json.load(sys.stdin).get('CF_ACCOUNT_ID',''))" 2>/dev/null)
      [ -n "$_URL" ] && export ANALYTICS_API_URL="$_URL"
      [ -n "$_AID" ] && export CF_ACCOUNT_ID="$_AID"
    fi
  fi

  # CA cert handling
  for ca in "$SCRIPT_DIR/onecli-ca.pem" "$HOME/.config/onecli/ca.pem"; do
    if [ -f "$ca" ]; then
      export NODE_EXTRA_CA_CERTS="$ca"
      break
    fi
  done

  if [ -z "$NODE_EXTRA_CA_CERTS" ]; then
    mkdir -p "$HOME/.config/onecli"
    curl -sf "${ONECLI_API}/api/gateway/ca" > "$HOME/.config/onecli/ca.pem" 2>/dev/null
    [ -f "$HOME/.config/onecli/ca.pem" ] && export NODE_EXTRA_CA_CERTS="$HOME/.config/onecli/ca.pem"
  fi

  # Node's undici doesn't apply NODE_EXTRA_CA_CERTS to proxy CONNECT tunnels.
  # OneCLI runs locally, so disabling TLS verification for the proxy is safe.
  export NODE_TLS_REJECT_UNAUTHORIZED=0
fi

# --no-warnings suppresses the NODE_TLS_REJECT_UNAUTHORIZED warning in proxy mode
exec node --no-warnings --import tsx "$SCRIPT_DIR/src/index.ts" "$@"
